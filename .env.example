# Server-only, never NEXT_PUBLIC_*
OPENAI_API_KEY=
# gpt-6-luna is also supported, with reasoning effort automatically set to none.
OPENAI_CHAT_MODEL=gpt-4.1-mini-2025-04-14
# Required in production; optional during local development.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RAG_REQUESTS_PER_MINUTE=20
RAG_REQUESTS_PER_DAY=100
RAG_GENERATIONS_PER_DAY=500
RAG_MIN_SIMILARITY=0.3

# Stable public HTTPS origin for canonical URLs, hreflang and sitemap.
# On Vercel, defaults to VERCEL_PROJECT_PRODUCTION_URL if left unset.
# Set explicitly when using a custom domain, then redeploy.
SITE_URL=
